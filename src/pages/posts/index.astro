---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Posts — Alireza Naghdipour" description="Thoughts on backend engineering, distributed systems, and software design.">
  <Nav />
  <main class="max-w-4xl mx-auto px-6 pt-28 pb-24">
    <div class="mb-12">
      <h1 class="font-mono text-xs text-emerald-600 dark:text-[#00ff87] tracking-widest uppercase mb-4">Posts</h1>
      <p class="text-gray-500 text-sm">Thoughts on backend engineering, distributed systems, and software design.</p>
    </div>

    {posts.length === 0 ? (
      <p class="text-gray-400 dark:text-gray-600 font-mono text-sm">No posts yet. Check back soon.</p>
    ) : (
      <div class="divide-y divide-gray-200 dark:divide-white/5">
        {posts.map(post => (
          <article class="py-8 group">
            <a href={`/posts/${post.id}`} class="block">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-2">
                <h2 class="text-gray-900 dark:text-white font-semibold group-hover:text-emerald-600 dark:group-hover:text-[#00ff87] transition-colors">
                  {post.data.title}
                </h2>
                <time class="font-mono text-xs text-gray-400 dark:text-gray-700 shrink-0">
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <p class="text-gray-500 text-sm leading-relaxed mb-3">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="flex gap-2 flex-wrap">
                  {post.data.tags.map((tag: string) => (
                    <span class="font-mono text-xs text-gray-400 dark:text-gray-700 bg-gray-100 dark:bg-white/3 px-2 py-0.5 rounded">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </article>
        ))}
      </div>
    )}
  </main>
  <Footer />
</Layout>
