---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
const post = await getEntry('posts', slug as string);
if (!post) return Astro.redirect('/posts');

const { Content } = await render(post);
---

<Layout title={`${post.data.title} — Alireza Naghdipour`} description={post.data.description}>
  <Nav />
  <main class="max-w-2xl mx-auto px-6 pt-28 pb-24">
    <a href="/posts" class="font-mono text-xs text-gray-400 dark:text-gray-600 hover:text-emerald-600 dark:hover:text-[#00ff87] transition-colors mb-10 inline-flex items-center gap-2">
      ← All posts
    </a>

    <header class="mb-12">
      <time class="font-mono text-xs text-gray-400 dark:text-gray-600 block mb-3">
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">{post.data.title}</h1>
      <p class="text-gray-500 leading-relaxed">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="flex gap-2 flex-wrap mt-4">
          {post.data.tags.map((tag: string) => (
            <span class="font-mono text-xs text-gray-400 dark:text-gray-700 bg-gray-100 dark:bg-white/3 px-2 py-0.5 rounded">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-gray dark:prose-invert prose-sm max-w-none
      prose-headings:font-semibold
      prose-a:text-emerald-600 dark:prose-a:text-[#00ff87] prose-a:no-underline hover:prose-a:underline
      prose-code:text-emerald-700 dark:prose-code:text-[#00ff87] prose-code:bg-emerald-50 dark:prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-xs
      prose-pre:bg-gray-100 dark:prose-pre:bg-white/5 prose-pre:border prose-pre:border-gray-200 dark:prose-pre:border-white/10
      prose-blockquote:border-l-emerald-500 dark:prose-blockquote:border-l-[#00ff87]">
      <Content />
    </div>
  </main>
  <Footer />
</Layout>
